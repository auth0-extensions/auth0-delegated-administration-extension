AUTH0_DOMAIN=
# Optional: enterprise, for tenants with the enterprise Management API rate limits, so tests wait less between Management API calls. Defaults to free
AUTH0_TENANT_TIER=
DAE_INSTALLER_PATH=
# Optional: full URL of a DAE build to install, overriding --prod, --dev and --version
DAE_CDN_PATH=
# Optional: left,top,width,height of every browser window, in screen points, e.g. for screen recordings
DAE_E2E_WINDOW=
